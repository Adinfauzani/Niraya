# Phase 8I optional infrastructure (do not commit secrets)
# Distributed rate limiting (Upstash Redis REST). If unset, in-memory fallback is used (dev/single instance only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Durable private payment proof storage (S3-compatible). Local .data fallback is dev-only, not Vercel durable.
# PAYMENT_PROOF_STORAGE=local|s3
# PAYMENT_PROOF_S3_ENDPOINT=
# PAYMENT_PROOF_S3_REGION=
# PAYMENT_PROOF_S3_BUCKET=
# PAYMENT_PROOF_S3_ACCESS_KEY_ID=
# PAYMENT_PROOF_S3_SECRET_ACCESS_KEY=
# PAYMENT_PROOF_S3_FORCE_PATH_STYLE=true
# E2E/browser tests (dev only)
# PLAYWRIGHT_BASE_URL=
