NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Session pooler (port 5432). The transaction pooler (6543) drops postgres.js
# pipelined replies and hangs under concurrency (queries stuck on ClientRead).
DATABASE_URL="postgresql://postgres.jk[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Better Auth
BETTER_AUTH_SECRET=[generate with: openssl rand -base64 32]
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_API_KEY=[generate with: npx @better-auth/cli keys --output .env.local]

# OAuth providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

GUMROAD_SELLER_ID=
GUMROAD_ACCESS_TOKEN=
GUMROAD_PRODUCT_STARTER=opghbu
GUMROAD_PRODUCT_PLUS=ebwsuv
GUMROAD_PRODUCT_PRO=wpartz
GUMROAD_VERIFY_WEBHOOK=false

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=